# Copy to deploy/.env and fill in. deploy/.env is gitignored; never commit real values.

# Database name and the owner account that the backend connects with.
SIMGUARD_DB_NAME=simguard
SIMGUARD_DB_OWNER=simguard_owner
SIMGUARD_DB_OWNER_PASSWORD=

# Password of the read-only role the ML service uses (deploy/postgres/ml-readonly.sql).
SIMGUARD_ML_USER=simguard_ml
SIMGUARD_ML_PASSWORD=

# Optional: compose project name (volumes and containers are prefixed with it).
# COMPOSE_PROJECT_NAME=simguard

# Backend settings (used when the backend service is added to the compose file).
# Connection string key the backend reads: ConnectionStrings__DefaultConnection
# ConnectionStrings__DefaultConnection=Host=postgres;Port=5432;Database=simguard;Username=simguard_owner;Password=<owner password>
# Database__MigrateOnStartup=true
# First Admin (only used while there are no accounts; remove the password after the first sign-in):
# SimGuard__Seed__AdminEmail=
# SimGuard__Seed__AdminPassword=
