# Copy to deploy/.env, fill in, then: chmod 600 deploy/.env
# deploy/.env is gitignored. Never commit real values. deploy/scripts/preflight.sh
# fails while any value below is still CHANGE_ME or empty where one is required.
# Generate each secret with:  openssl rand -hex 24
# Use letters and digits only in passwords (no spaces, quotes, ; or $): they go into a connection string.

# --- Public address -----------------------------------------------------------
# One hostname. Its DNS A record must point at this VM (80 and 443 open) before
# the first start, or Let's Encrypt cannot issue the certificate.
DOMAIN=sim-guard.app

# --- Database -----------------------------------------------------------------
SIMGUARD_DB_NAME=simguard
SIMGUARD_DB_OWNER=simguard_owner
SIMGUARD_DB_OWNER_PASSWORD=CHANGE_ME

# Read-only role the ML service uses (created by the stack on every start).
SIMGUARD_ML_USER=simguard_ml
SIMGUARD_ML_PASSWORD=CHANGE_ME

# --- Secrets shared by services ----------------------------------------------
# Signs sign-in tokens (backend). At least 32 characters.
JWT_KEY=CHANGE_ME
# Backend sends it to the ML service, which checks it. At least 32 characters.
ML_SHARED_SECRET=CHANGE_ME

# --- Folders on this VM (absolute paths, copied there before the first start) --
# Model artifacts (the .joblib and .json files from ml-service/artifacts).
SIMGUARD_ML_ARTIFACTS_DIR=/srv/simguard/ml-artifacts
# Carrier mock data: deploy/data-pack/mock-data from prepare-data.py.
SIMGUARD_MOCK_DATA_DIR=/srv/simguard/mock-data
# Carrier keys: deploy/data-pack/mock.env from prepare-data.py (mode 600).
SIMGUARD_MOCK_ENV_FILE=/srv/simguard/mock.env

# --- First Admin ----------------------------------------------------------------
# Used only while there are no accounts. Remove the password after the first
# sign-in and restart the backend only. Password: 12 or more characters.
SIMGUARD_ADMIN_EMAIL=
SIMGUARD_ADMIN_PASSWORD=
# Emergency recovery of a locked out Admin: see docs/deployment.md. Keep false otherwise.
SIMGUARD_RECOVER_ADMIN=false

# --- Email (Brevo): must work before you invite users ---------------------------
BREVO_API_KEY=
BREVO_SENDER_EMAIL=no-reply@sim-guard.app
# Link in invitation emails. Default: https://<DOMAIN>/login
# BREVO_SIGN_IN_URL=

# --- Optional --------------------------------------------------------------------
# Carrier mock "today" (yyyy-MM-dd). Empty = the last date in the data.
CARRIER_MOCK_DATE=
# Subnet of the private network (change only if it clashes with something on the VM).
SIMGUARD_SUBNET=172.29.77.0/24
# Worker processes for forecast fits in the ML service.
ML_PROPHET_N_JOBS=2
# Prefix for container and volume names.
# COMPOSE_PROJECT_NAME=simguard
# Local test only: HTTP_PORT=8088, HTTPS_PORT=8443, CADDY_GLOBAL_OPTIONS=local_certs
# HTTP_PORT=80
# HTTPS_PORT=443
# CADDY_GLOBAL_OPTIONS=
