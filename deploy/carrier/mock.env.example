# Example of /srv/carrier/mock.env on the carrier host. Do not fill this file in:
# create the real one on the host with deploy/carrier/scripts/create-mock-env.sh
# (mode 600, owner root). Never commit it, never copy one from anywhere.

# One key per carrier in sims.csv. The SimGuard Settings screen needs the same key.
CarrierMock__Keys__Safaricom=
CarrierMock__Keys__Airtel=
CarrierMock__Keys__Telkom=

# Key for the demo controls (/admin/...). Empty: any carrier key opens them.
MOCK_ADMIN_KEY=

# Nightly release (empty = default).
# Days released at the first start (default 80 of the 90 days).
MOCK_START_DAY=
# Local release time, HH:mm (default 01:00).
MOCK_RELEASE_TIME=
# IANA time zone of the release time (default Africa/Nairobi).
MOCK_TIMEZONE=
# Move the served dates by whole weeks, a multiple of 7 (default 0). See docs/carrier-feed.md.
MOCK_DATE_SHIFT_DAYS=
# false turns the nightly release off (default true).
MOCK_SCHEDULER_ENABLED=
