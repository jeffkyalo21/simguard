# Backend (ASP.NET Core) settings. ASP.NET Core reads environment variables with
# "__" in place of ":" (Jwt:Key is Jwt__Key). For local work prefer
# "dotnet user-secrets set" with the colon names; this file lists every key.
# Copy to .env, fill in, never commit it. The Docker stack uses deploy/.env.example.
# Keys and defaults are explained in docs/auth.md and appsettings.json.

ASPNETCORE_ENVIRONMENT=Development

# --- Database ------------------------------------------------------------------
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=simguard;Username=CHANGE_ME;Password=CHANGE_ME
# true applies pending EF migrations at start (the Docker stack sets it).
Database__MigrateOnStartup=false

# --- Sign-in -------------------------------------------------------------------
# At least 32 characters. Required outside Development. Generate: openssl rand -hex 24
Jwt__Key=CHANGE_ME
Cors__AllowedOrigins__0=http://localhost:3000

# --- First Admin (used only while there are no accounts) ------------------------
SimGuard__Seed__AdminEmail=admin@simguard.local
# 12 or more characters. Remove after the first sign-in.
SimGuard__Seed__AdminPassword=CHANGE_ME
SimGuard__Seed__RecoverAdmin=false

# --- ML service ----------------------------------------------------------------
MlService__BaseUrl=http://127.0.0.1:8001
# Same value as ML_SHARED_SECRET in ml-service. At least 32 characters.
MlService__SharedSecret=CHANGE_ME

# --- Carrier feed ----------------------------------------------------------------
# true only for the demo carrier mock over plain http.
CarrierFeed__AllowInsecureHttp=false

# --- Email (Brevo). Without an API key no email is sent. ------------------------
Brevo__ApiKey=
Brevo__SenderEmail=no-reply@example.com
Brevo__SignInUrl=http://localhost:3000/login

# --- Behind a TLS proxy (Docker stack) --------------------------------------------
# Hosting__UseHttpsRedirection=false
# Hosting__DataProtectionKeysPath=/keys
# ForwardedHeaders__KnownNetworks__0=172.29.77.0/24

# --- Tests ------------------------------------------------------------------------
# Server the tests may create throwaway databases on.
# SIMGUARD_TEST_CONNECTION=Host=localhost;Port=5432;Username=CHANGE_ME;Password=CHANGE_ME
