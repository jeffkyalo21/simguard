{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "MlService": {
    "BaseUrl": "http://127.0.0.1:8001",
    "TimeoutSeconds": 120,
    "RecommendTimeoutSeconds": 600
  },
  "Scoring": {
    "Enabled": true,
    "DailyRunTimeNairobi": "02:00",
    "BatchSize": 1000,
    "SustainedWindowDays": 5,
    "SustainedMinDays": 3,
    "FalsePositiveCooldownDays": 7
  },
  "TierRecommendations": {
    "AutoRunGraceDays": 14,
    "CheckIntervalHours": 24,
    "BatchSize": 200
  }
}
