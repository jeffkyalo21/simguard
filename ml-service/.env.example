# SimGuard ML service settings (environment variables). Copy to .env or export
# them in the shell, never commit real values. Details in README.md.
# The Docker stack sets these from deploy/.env.example.

# Development lets the service start without a shared secret (check off, warning
# logged). Any other value requires ML_SHARED_SECRET.
ML_ENVIRONMENT=Development
# At least 32 characters; same value as MlService__SharedSecret in the backend.
ML_SHARED_SECRET=CHANGE_ME

# Folder with the model artifacts (default: ml-service/artifacts).
# ML_ARTIFACT_DIR=artifacts

# parquet reads data/synthetic_cdr_daily_agg.csv. postgres reads the backend view ml_daily_usage.
READER=parquet
# Required when READER=postgres. Use a read-only role.
# ML_DATABASE_URL=postgresql://CHANGE_ME:CHANGE_ME@localhost:5432/simguard

# Parquet reader only.
# ML_DAILY_USAGE_PATH=data/synthetic_cdr_daily_agg.csv
# ML_PROPHET_CHECKPOINTS=data/prophet_checkpoints.parquet
# 0 always fits Prophet instead of reading the precomputed forecasts.
# ML_USE_PRECOMPUTED_PROPHET=1
# joblib workers for Prophet fits (-1 is all cores).
# ML_PROPHET_N_JOBS=-1
